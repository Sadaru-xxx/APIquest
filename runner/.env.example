# 実行サーバーのドメイン(DNS の A レコードをこのサーバーの IP に向けておく)
RUNNER_DOMAIN=runner.example.com
# OAuth の許可画面で入力するパスフレーズ(16文字以上)。openssl rand -base64 18 などで作成
RUNNER_OWNER_PASSPHRASE=
# 固定トークン(コネクタの Request headers と動作確認に使う)。openssl rand -hex 32 で作成
# カンマ区切りで複数指定でき、入れ替え(ローテーション)に使う
RUNNER_TOKENS=
# OAuth で許可するリダイレクト先(通常は変更不要)
# RUNNER_OAUTH_REDIRECT_PREFIXES=https://claude.ai/,https://claude.com/
# docker.sock のグループ ID。stat -c %g /var/run/docker.sock で確認
DOCKER_GID=
# 同時実行数・待ち行列・認証ごとの1分あたりのリクエスト上限
RUNNER_CONCURRENCY=4
RUNNER_QUEUE=16
RUNNER_RATE_PER_MIN=120
