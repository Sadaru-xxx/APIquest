{
  "name": "java-silver-se17",
  "private": true,
  "description": "Java Silver SE 17(1Z0-825-JPN)の演習中心の学習アプリ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "questions:build": "node authoring/build-questions.mjs",
    "questions:verify": "node tools/verify-questions.mjs --write --report reports/verification-report.json",
    "questions": "npm run questions:build && npm run questions:verify",
    "review": "node tools/render-review.mjs",
    "setup": "npm --prefix app ci",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build"
  }
}
